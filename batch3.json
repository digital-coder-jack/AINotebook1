{"frontend/signup.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" />\n  <link rel=\"icon\" type=\"image/svg+xml\" href=\"/assets/logo.png\" />\n  <link rel=\"manifest\" href=\"/manifest.json\">\n<link rel=\"icon\" type=\"image/png\" href=\"/assets/logo-192.png\">\n<link rel=\"apple-touch-icon\" href=\"/assets/logo-192.png\">\n<meta name=\"theme-color\" content=\"#4F46E5\">\n  <script>\n    (function () {\n      try {\n        var r = document.documentElement;\n        r.setAttribute('data-theme', localStorage.getItem('ss_theme') || 'dark');\n        r.setAttribute('data-accent', localStorage.getItem('ss_accent') || 'violet');\n        r.setAttribute('data-font', localStorage.getItem('ss_font') || 'md');\n      } catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }\n    })();\n  </script>\n  <title>Create account \u00b7 AI Notebook</title>\n  <meta name=\"theme-color\" content=\"#4F46E5\" />\n  <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n  <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\" />\n  <meta name=\"apple-mobile-web-app-title\" content=\"AI Notebook\" />\n  <link rel=\"manifest\" href=\"/manifest.json\" />\n  <link rel=\"apple-touch-icon\" href=\"/assets/logo-192.png\" />\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\" />\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css\" />\n  <link rel=\"stylesheet\" href=\"/css/premium-design-system.css\" />\n  <link rel=\"stylesheet\" href=\"/css/style.css\" />\n  <link rel=\"stylesheet\" href=\"/css/auth.css\" />\n  <link rel=\"stylesheet\" href=\"/css/responsive.css\" />\n  \n  <!-- Vercel Speed Insights -->\n  <script type=\"module\">\n    import { injectSpeedInsights } from 'https://cdn.jsdelivr.net/npm/@vercel/speed-insights@2.0.0/dist/index.mjs';\n    injectSpeedInsights();\n  </script>\n\n  <!-- Premium layer (loaded last to override legacy tokens) -->\n  <link rel=\"stylesheet\" href=\"/css/components.css\" />\n  <link rel=\"stylesheet\" href=\"/css/auth-premium.css\" />\n  <link rel=\"stylesheet\" href=\"/css/rescue.css\" />\n  <link rel=\"stylesheet\" href=\"/css/theme.css\" />\n<link rel=\"stylesheet\" href=\"/css/workspace-redesign.css\" />\n</head>\n<body>\n  <div id=\"particles-js\"></div>\n  <div id=\"toast-wrap\"></div>\n  <a class=\"back-home\" href=\"/\"><i class=\"fas fa-arrow-left\"></i> Home</a>\n  <button class=\"theme-toggle floating\" id=\"themeToggle\" aria-label=\"Toggle theme\" title=\"Toggle light / dark\">\n    <i class=\"fas fa-moon\"></i><i class=\"fas fa-sun\"></i>\n  </button>\n\n\t  <main class=\"auth-wrap\">\n\t    <aside class=\"auth-visual\" aria-label=\"AI Notebook workspace preview\">\n\t      <span class=\"auth-visual-kicker\"><i class=\"fas fa-sparkles\"></i> Start with intention</span>\n\t      <h2>Your best learning system is the one you\u2019ll <em>return to.</em></h2>\n\t      <p>Build a personal knowledge workspace that helps every question become something useful.</p>\n\t      <div class=\"auth-preview\">\n\t        <div class=\"auth-preview-head\"><span class=\"preview-dot\"></span><strong>Your first workspace</strong><span class=\"preview-status\">New</span></div>\n\t        <div class=\"preview-line wide\"></div><div class=\"preview-line short\"></div>\n\t        <div class=\"preview-insight\"><i class=\"fas fa-compass\"></i><span><b>Make room for ideas</b><small>Notes, chats, and plans in one view</small></span><i class=\"fas fa-arrow-up-right-from-square\"></i></div>\n\t      </div>\n\t      <div class=\"auth-proof\"><span><i class=\"fas fa-check\"></i> Free to get started</span><span><i class=\"fas fa-check\"></i> Your space, your pace</span></div>\n\t    </aside>\n\t    <section class=\"auth-card glass\">\n      <a class=\"brand\" href=\"/\"><span class=\"logo\"><img src=\"/assets/logo.png\" alt=\"AI Notebook Logo\" class=\"logo-img\" /></span><span>AI <span class=\"grad-text\">Notebook</span></span></a>\n      <h1>Create your account</h1>\n      <p class=\"sub\">Start studying smarter in under a minute</p>\n\n      <div class=\"form-msg\" id=\"formMsg\"></div>\n\n      <form id=\"signupForm\" novalidate>\n        <div class=\"field\">\n          <label for=\"name\">Full name</label>\n          <div class=\"input-wrap\">\n            <i class=\"fas fa-user lead-icon\"></i>\n            <input type=\"text\" id=\"name\" name=\"name\" placeholder=\"Jane Doe\" autocomplete=\"name\" required />\n          </div>\n        </div>\n        <div class=\"field\">\n          <label for=\"username\">Username</label>\n          <div class=\"input-wrap\">\n            <i class=\"fas fa-at lead-icon\"></i>\n            <input type=\"text\" id=\"username\" name=\"username\" placeholder=\"janedoe\" required />\n          </div>\n        </div>\n        <div class=\"field\">\n          <label for=\"email\">Email</label>\n          <div class=\"input-wrap\">\n            <i class=\"fas fa-envelope lead-icon\"></i>\n            <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"you@example.com\" autocomplete=\"email\" required />\n          </div>\n        </div>\n        <div class=\"field\">\n          <label for=\"password\">Password</label>\n          <div class=\"input-wrap\">\n            <i class=\"fas fa-lock lead-icon\"></i>\n            <input type=\"password\" id=\"password\" name=\"password\" placeholder=\"At least 6 characters\" autocomplete=\"new-password\" required />\n            <button type=\"button\" class=\"toggle-pw\" data-target=\"password\"><i class=\"fas fa-eye\"></i></button>\n          </div>\n          <div class=\"pw-strength\"><span id=\"pwBar\"></span></div>\n        </div>\n        <div class=\"field\">\n          <label for=\"confirm_password\">Confirm Password</label>\n          <div class=\"input-wrap\">\n            <i class=\"fas fa-shield-halved lead-icon\"></i>\n            <input type=\"password\" id=\"confirm_password\" name=\"confirm_password\" placeholder=\"\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\" required />\n            <button type=\"button\" class=\"toggle-pw\" data-target=\"confirm_password\"><i class=\"fas fa-eye\"></i></button>\n          </div>\n        </div>\n        <button type=\"submit\" class=\"btn block\" id=\"submitBtn\"><i class=\"fas fa-user-plus\"></i> Create account</button>\n      </form>\n\n      <div class=\"auth-or\">or</div>\n      <button type=\"button\" class=\"btn ghost block\" data-guest><i class=\"fas fa-user-secret\"></i> Continue as Guest</button>\n\n      <p class=\"auth-foot\">Already have an account? <a href=\"/login\">Log in</a></p>\n    </section>\n  </main>\n\n  <script src=\"https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js\"></script>\n  <script src=\"/js/config.js\"></script>\n  <script src=\"/js/app.js\"></script>\n  <script src=\"/js/motion.js\"></script>\n  <script src=\"/js/pwa.js\"></script>\n  <script src=\"/js/auth.js\"></script>\n</body>\n</html>\n", "frontend/telegram.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" />\n  <link rel=\"icon\" type=\"image/svg+xml\" href=\"/assets/logo.png\" />\n  <link rel=\"manifest\" href=\"/manifest.json\">\n<link rel=\"icon\" type=\"image/png\" href=\"/assets/logo-192.png\">\n<link rel=\"apple-touch-icon\" href=\"/assets/logo-192.png\">\n<meta name=\"theme-color\" content=\"#4F46E5\">\n  <script>\n    (function () {\n      try {\n        var t = localStorage.getItem('ss_theme') || 'dark';\n        document.documentElement.setAttribute('data-theme', t);\n      } catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }\n    })();\n  </script>\n  <title>Telegram \u00b7 AI Notebook</title>\n  <meta name=\"theme-color\" content=\"#4F46E5\" />\n  <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n  <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\" />\n  <meta name=\"apple-mobile-web-app-title\" content=\"AI Notebook\" />\n  <link rel=\"manifest\" href=\"/manifest.json\" />\n  <link rel=\"apple-touch-icon\" href=\"/assets/logo-192.png\" />\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\" />\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css\" />\n  <link rel=\"stylesheet\" href=\"/css/premium-design-system.css\" />\n  <link rel=\"stylesheet\" href=\"/css/style.css\" />\n  <link rel=\"stylesheet\" href=\"/css/dashboard.css\" />\n  <link rel=\"stylesheet\" href=\"/css/sidebar-mobile.css\" />\n  <link rel=\"stylesheet\" href=\"/css/responsive.css\" />\n\n  <!-- Vercel Speed Insights -->\n  <script type=\"module\">\n    import { injectSpeedInsights } from 'https://cdn.jsdelivr.net/npm/@vercel/speed-insights@2.0.0/dist/index.mjs';\n    injectSpeedInsights();\n  </script>\n\n  <style>\n    .tg-hero {\n      display: flex; align-items: center; gap: 1.2rem;\n      padding: 1.6rem; border-radius: 18px; margin-bottom: 1.6rem;\n    }\n    /* BRANDING: official logo only, on a transparent surface \u2014 no badge box */\n    .tg-hero .tg-logo { width: 72px; height: 72px; object-fit: contain; flex-shrink: 0; }\n    .tg-hero h2 { margin: 0 0 .3rem; font-size: 1.4rem; }\n    .tg-hero p { margin: 0; color: var(--text-dim); }\n    .tg-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.1rem; }\n    .tg-card { padding: 1.5rem; }\n    .tg-card h3 { display: flex; align-items: center; gap: .6rem; margin: 0 0 .8rem; font-size: 1.05rem; }\n    .tg-card h3 i { color: var(--accent); }\n    .tg-card ul { margin: .4rem 0 0; padding-left: 1.1rem; color: var(--text-dim); line-height: 1.9; }\n    .tg-card code {\n      background: var(--glass); border: 1px solid var(--border);\n      padding: .15rem .45rem; border-radius: 7px; font-size: .85rem;\n    }\n    .tg-cta { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1rem; }\n    @media (max-width: 1024px) { .tg-grid { grid-template-columns: 1fr; } }\n    @media (max-width: 480px) {\n      .tg-hero { flex-direction: column; text-align: center; }\n      .tg-cta .btn { width: 100%; justify-content: center; }\n    }\n  </style>\n  <link rel=\"stylesheet\" href=\"/css/components.css\" />\n  <link rel=\"stylesheet\" href=\"/css/sidebar.css\" />\n  <link rel=\"stylesheet\" href=\"/css/command-palette.css\" />\n  <link rel=\"stylesheet\" href=\"/css/rescue.css\" />\n  <link rel=\"stylesheet\" href=\"/css/theme.css\" />\n<link rel=\"stylesheet\" href=\"/css/workspace-redesign.css\" />\n</head>\n<body>\n  <div id=\"particles-js\"></div>\n  <div id=\"toast-wrap\"></div>\n  <div class=\"side-overlay\" id=\"sideOverlay\"></div>\n\n  <div class=\"app-shell\">\n    <aside class=\"sidebar\" id=\"sidebar\" data-active=\"telegram\"></aside>\n\n    <main class=\"content\">\n      <header class=\"topbar\">\n        <div>\n          <h1>Telegram Bot \ud83e\udd16</h1>\n          <p class=\"sub\">Use AI Notebook right inside Telegram.</p>\n        </div>\n        <button class=\"sidebar-toggle\" id=\"sidebarToggle\" aria-label=\"Open navigation menu\"><i class=\"fas fa-bars\"></i></button>\n      </header>\n\n      <section class=\"tg-hero glass\">\n        <img class=\"tg-logo\" src=\"/assets/logo.png\" alt=\"AI Notebook logo\" />\n        <div>\n          <h2>AI Notebook on Telegram</h2>\n          <p>Ask questions, save a personal Q&amp;A library, and get AI answers \u2014 all from your favourite chat app. The bot shares the same AI engine as this web app.</p>\n        </div>\n      </section>\n\n      <section class=\"tg-grid\">\n        <article class=\"tg-card glass\">\n          <h3><i class=\"fas fa-terminal\"></i> Bot commands</h3>\n          <ul>\n            <li><code>/start</code> \u2014 introduction &amp; quick help</li>\n            <li><code>/help</code> \u2014 list all commands</li>\n            <li><code>/add</code> \u2014 save a question &amp; answer</li>\n            <li><code>/list</code> \u2014 view your saved Q&amp;A</li>\n            <li><code>/delete</code> \u2014 remove a saved item</li>\n            <li>Send any message \u2014 get an instant AI answer</li>\n          </ul>\n        </article>\n\n        <article class=\"tg-card glass\">\n          <h3><i class=\"fas fa-rocket\"></i> Getting started</h3>\n          <ul>\n            <li>Open Telegram and search for the AI Notebook bot.</li>\n            <li>Tap <b>Start</b> to begin a conversation.</li>\n            <li>Send <code>/help</code> to see everything it can do.</li>\n            <li>Your bot library and web account stay in sync.</li>\n          </ul>\n          <div class=\"tg-cta\">\n            <a class=\"btn primary\" id=\"tgOpenBtn\" href=\"#\" target=\"_blank\" rel=\"noopener\">\n              <i class=\"fab fa-telegram\"></i> Open Telegram\n            </a>\n            <a class=\"btn\" href=\"/chat\"><i class=\"fas fa-comments\"></i> Use web chat instead</a>\n          </div>\n        </article>\n      </section>\n    </main>\n  </div>\n\n  <script src=\"https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js\"></script>\n  <script src=\"/js/config.js\"></script>\n  <script src=\"/js/analytics-tracker.js\"></script>\n  <script src=\"/js/app.js\"></script>\n  <script src=\"/js/motion.js\"></script>\n  <script src=\"/js/command-palette.js\"></script>\n  <script src=\"/js/pwa.js\"></script>\n  <script src=\"/js/sidebar.js\"></script>\n  <script>\n    // Resolve the bot link from config if provided, else fall back to Telegram home.\n    (function () {\n      var handle = (window.SS_TELEGRAM_BOT || '').replace(/^@/, '').trim();\n      var btn = document.getElementById('tgOpenBtn');\n      if (btn) btn.href = handle ? ('https://t.me/' + handle) : 'https://telegram.org/';\n    })();\n  </script>\n</body>\n</html>\n", "frontend/forgot.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" />\n  <link rel=\"icon\" type=\"image/svg+xml\" href=\"/assets/logo.png\" />\n  <link rel=\"manifest\" href=\"/manifest.json\">\n<link rel=\"icon\" type=\"image/png\" href=\"/assets/logo-192.png\">\n<link rel=\"apple-touch-icon\" href=\"/assets/logo-192.png\">\n<meta name=\"theme-color\" content=\"#4F46E5\">\n  <script>\n    (function () {\n      try {\n        var r = document.documentElement;\n        r.setAttribute('data-theme', localStorage.getItem('ss_theme') || 'dark');\n        r.setAttribute('data-accent', localStorage.getItem('ss_accent') || 'violet');\n        r.setAttribute('data-font', localStorage.getItem('ss_font') || 'md');\n      } catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }\n    })();\n  </script>\n  <title>Reset password \u00b7 AI Notebook</title>\n  <meta name=\"theme-color\" content=\"#4F46E5\" />\n  <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n  <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\" />\n  <meta name=\"apple-mobile-web-app-title\" content=\"AI Notebook\" />\n  <link rel=\"manifest\" href=\"/manifest.json\" />\n  <link rel=\"apple-touch-icon\" href=\"/assets/logo-192.png\" />\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\" />\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css\" />\n  <link rel=\"stylesheet\" href=\"/css/style.css\" />\n  <link rel=\"stylesheet\" href=\"/css/auth.css\" />\n  <link rel=\"stylesheet\" href=\"/css/responsive.css\" />\n  \n  <!-- Vercel Speed Insights -->\n  <script type=\"module\">\n    import { injectSpeedInsights } from 'https://cdn.jsdelivr.net/npm/@vercel/speed-insights@2.0.0/dist/index.mjs';\n    injectSpeedInsights();\n  </script>\n\n  <!-- Premium layer (loaded last to override legacy tokens) -->\n  <link rel=\"stylesheet\" href=\"/css/components.css\" />\n  <link rel=\"stylesheet\" href=\"/css/auth-premium.css\" />\n  <link rel=\"stylesheet\" href=\"/css/rescue.css\" />\n  <link rel=\"stylesheet\" href=\"/css/theme.css\" />\n<link rel=\"stylesheet\" href=\"/css/workspace-redesign.css\" />\n</head>\n<body>\n  <div id=\"particles-js\"></div>\n  <div id=\"toast-wrap\"></div>\n  <a class=\"back-home\" href=\"/login\"><i class=\"fas fa-arrow-left\"></i> Back to login</a>\n  <button class=\"theme-toggle floating\" id=\"themeToggle\" aria-label=\"Toggle theme\" title=\"Toggle light / dark\">\n    <i class=\"fas fa-moon\"></i><i class=\"fas fa-sun\"></i>\n  </button>\n\n\t  <main class=\"auth-wrap\">\n\t    <aside class=\"auth-visual\" aria-label=\"AI Notebook account security\">\n\t      <span class=\"auth-visual-kicker\"><i class=\"fas fa-shield-halved\"></i> Account security</span>\n\t      <h2>A secure reset, with your progress <em>still waiting.</em></h2>\n\t      <p>Recover your account and return to the workspace you\u2019ve built without losing your momentum.</p>\n\t      <div class=\"auth-preview\">\n\t        <div class=\"auth-preview-head\"><span class=\"preview-dot\"></span><strong>Private by design</strong><span class=\"preview-status\">Protected</span></div>\n\t        <div class=\"preview-line wide\"></div><div class=\"preview-line medium\"></div>\n\t        <div class=\"preview-insight\"><i class=\"fas fa-lock\"></i><span><b>Your notes stay yours</b><small>We\u2019ll guide you back in safely</small></span><i class=\"fas fa-check\"></i></div>\n\t      </div>\n\t      <div class=\"auth-proof\"><span><i class=\"fas fa-check\"></i> Simple recovery</span><span><i class=\"fas fa-check\"></i> No lost notes</span></div>\n\t    </aside>\n\t    <section class=\"auth-card glass\">\n      <a class=\"brand\" href=\"/\"><span class=\"logo\"><img src=\"/assets/logo.png\" alt=\"AI Notebook Logo\" class=\"logo-img\" /></span><span>AI <span class=\"grad-text\">Notebook</span></span></a>\n      <h1>Reset your password</h1>\n      <p class=\"sub\">Step 1: request a reset token \u00b7 Step 2: set a new password</p>\n\n      <div class=\"form-msg\" id=\"formMsg\"></div>\n\n      <!-- Step 1: request token -->\n      <form id=\"forgotForm\" novalidate>\n        <div class=\"field\">\n          <label for=\"email\">Email</label>\n          <div class=\"input-wrap\">\n            <i class=\"fas fa-envelope lead-icon\"></i>\n            <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"you@example.com\" autocomplete=\"email\" required />\n          </div>\n        </div>\n        <button type=\"submit\" class=\"btn block\" id=\"requestBtn\"><i class=\"fas fa-paper-plane\"></i> Request reset token</button>\n      </form>\n\n      <!-- Step 2: reset with token (revealed after step 1) -->\n      <form id=\"resetForm\" novalidate style=\"display:none; margin-top:1.4rem;\">\n        <div class=\"field\">\n          <label for=\"token\">Reset token</label>\n          <div class=\"input-wrap\">\n            <i class=\"fas fa-key lead-icon\"></i>\n            <input type=\"text\" id=\"token\" name=\"token\" placeholder=\"Paste your reset token\" required />\n          </div>\n        </div>\n        <div class=\"field\">\n          <label for=\"newPassword\">New password</label>\n          <div class=\"input-wrap\">\n            <i class=\"fas fa-lock lead-icon\"></i>\n            <input type=\"password\" id=\"newPassword\" name=\"newPassword\" placeholder=\"At least 6 characters\" autocomplete=\"new-password\" required />\n            <button type=\"button\" class=\"toggle-pw\" data-target=\"newPassword\"><i class=\"fas fa-eye\"></i></button>\n          </div>\n        </div>\n        <button type=\"submit\" class=\"btn block\" id=\"resetBtn\"><i class=\"fas fa-rotate\"></i> Set new password</button>\n      </form>\n\n      <p class=\"auth-foot\">Remembered it? <a href=\"/login\">Log in</a></p>\n    </section>\n  </main>\n\n  <script src=\"https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js\"></script>\n  <script src=\"/js/config.js\"></script>\n  <script src=\"/js/app.js\"></script>\n  <script src=\"/js/motion.js\"></script>\n  <script src=\"/js/pwa.js\"></script>\n  <script src=\"/js/auth.js\"></script>\n</body>\n</html>\n", "frontend/login.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" />\n  <link rel=\"icon\" type=\"image/svg+xml\" href=\"/assets/logo.png\" />\n  <link rel=\"manifest\" href=\"/manifest.json\">\n<link rel=\"icon\" type=\"image/png\" href=\"/assets/logo-192.png\">\n<link rel=\"apple-touch-icon\" href=\"/assets/logo-192.png\">\n<meta name=\"theme-color\" content=\"#4F46E5\">\n  <script>\n    (function () {\n      try {\n        var r = document.documentElement;\n        r.setAttribute('data-theme', localStorage.getItem('ss_theme') || 'dark');\n        r.setAttribute('data-accent', localStorage.getItem('ss_accent') || 'violet');\n        r.setAttribute('data-font', localStorage.getItem('ss_font') || 'md');\n      } catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }\n    })();\n  </script>\n  <title>Log in \u00b7 AI Notebook</title>\n  <meta name=\"theme-color\" content=\"#4F46E5\" />\n  <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n  <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\" />\n  <meta name=\"apple-mobile-web-app-title\" content=\"AI Notebook\" />\n  <link rel=\"manifest\" href=\"/manifest.json\" />\n  <link rel=\"apple-touch-icon\" href=\"/assets/logo-192.png\" />\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\" />\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css\" />\n  <link rel=\"stylesheet\" href=\"/css/premium-design-system.css\" />\n  <link rel=\"stylesheet\" href=\"/css/style.css\" />\n  <link rel=\"stylesheet\" href=\"/css/auth.css\" />\n  <link rel=\"stylesheet\" href=\"/css/responsive.css\" />\n  \n  <!-- Vercel Speed Insights -->\n  <script type=\"module\">\n    import { injectSpeedInsights } from 'https://cdn.jsdelivr.net/npm/@vercel/speed-insights@2.0.0/dist/index.mjs';\n    injectSpeedInsights();\n  </script>\n\n  <!-- Premium layer (loaded last to override legacy tokens) -->\n  <link rel=\"stylesheet\" href=\"/css/components.css\" />\n  <link rel=\"stylesheet\" href=\"/css/auth-premium.css\" />\n  <link rel=\"stylesheet\" href=\"/css/rescue.css\" />\n  <link rel=\"stylesheet\" href=\"/css/theme.css\" />\n<link rel=\"stylesheet\" href=\"/css/workspace-redesign.css\" />\n</head>\n<body>\n  <div id=\"particles-js\"></div>\n  <div id=\"toast-wrap\"></div>\n  <a class=\"back-home\" href=\"/\"><i class=\"fas fa-arrow-left\"></i> Home</a>\n  <button class=\"theme-toggle floating\" id=\"themeToggle\" aria-label=\"Toggle theme\" title=\"Toggle light / dark\">\n    <i class=\"fas fa-moon\"></i><i class=\"fas fa-sun\"></i>\n  </button>\n\n\t  <main class=\"auth-wrap\">\n\t    <aside class=\"auth-visual\" aria-label=\"AI Notebook workspace preview\">\n\t      <span class=\"auth-visual-kicker\"><i class=\"fas fa-sparkles\"></i> Personal AI workspace</span>\n\t      <h2>Turn scattered thoughts into <em>clear progress.</em></h2>\n\t      <p>One calm space for conversations, notes, roadmaps, and the ideas you want to keep.</p>\n\t      <div class=\"auth-preview\">\n\t        <div class=\"auth-preview-head\"><span class=\"preview-dot\"></span><strong>Today\u2019s workspace</strong><span class=\"preview-status\">Ready</span></div>\n\t        <div class=\"preview-line wide\"></div><div class=\"preview-line medium\"></div>\n\t        <div class=\"preview-insight\"><i class=\"fas fa-lightbulb\"></i><span><b>Next best step</b><small>Continue your AI Systems roadmap</small></span><i class=\"fas fa-arrow-up-right-from-square\"></i></div>\n\t      </div>\n\t      <div class=\"auth-proof\"><span><i class=\"fas fa-check\"></i> Focused workspace</span><span><i class=\"fas fa-check\"></i> Built for learning</span></div>\n\t    </aside>\n\t    <section class=\"auth-card glass\">\n      <a class=\"brand\" href=\"/\"><span class=\"logo\"><img src=\"/assets/logo.png\" alt=\"AI Notebook Logo\" class=\"logo-img\" /></span><span>AI <span class=\"grad-text\">Notebook</span></span></a>\n      <h1>Welcome back</h1>\n      <p class=\"sub\">Log in to continue your learning journey</p>\n\n      <div class=\"form-msg\" id=\"formMsg\"></div>\n\n      <form id=\"loginForm\" novalidate>\n        <div class=\"field\">\n          <label for=\"identifier\">Email or Username</label>\n          <div class=\"input-wrap\">\n            <i class=\"fas fa-user lead-icon\"></i>\n            <input type=\"text\" id=\"identifier\" name=\"identifier\" placeholder=\"you@example.com or janedoe\" required />\n          </div>\n        </div>\n        <div class=\"field\">\n          <label for=\"password\">Password</label>\n          <div class=\"input-wrap\">\n            <i class=\"fas fa-lock lead-icon\"></i>\n            <input type=\"password\" id=\"password\" name=\"password\" placeholder=\"\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\" autocomplete=\"current-password\" required />\n            <button type=\"button\" class=\"toggle-pw\" data-target=\"password\"><i class=\"fas fa-eye\"></i></button>\n          </div>\n        </div>\n        <div class=\"auth-row\">\n          <label><input type=\"checkbox\" id=\"remember\" checked /> Remember me</label>\n          <a href=\"/forgot\">Forgot password?</a>\n        </div>\n        <button type=\"submit\" class=\"btn block\" id=\"submitBtn\"><i class=\"fas fa-right-to-bracket\"></i> Log in</button>\n      </form>\n\n      <div class=\"auth-or\">or</div>\n      <button type=\"button\" class=\"btn ghost block\" data-guest><i class=\"fas fa-user-secret\"></i> Continue as Guest</button>\n\n      <p class=\"auth-foot\">Don't have an account? <a href=\"/signup\">Create one</a></p>\n    </section>\n  </main>\n\n  <script src=\"https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js\"></script>\n  <script src=\"/js/config.js\"></script>\n  <script src=\"/js/app.js\"></script>\n  <script src=\"/js/motion.js\"></script>\n  <script src=\"/js/pwa.js\"></script>\n  <script src=\"/js/auth.js\"></script>\n</body>\n</html>\n", "frontend/offline.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Offline \u00b7 AI Notebook</title>\n  <link rel=\"icon\" type=\"image/png\" href=\"/assets/logo.png\" />\n  <link rel=\"manifest\" href=\"/manifest.json\">\n<link rel=\"icon\" type=\"image/png\" href=\"/assets/logo-192.png\">\n<link rel=\"apple-touch-icon\" href=\"/assets/logo-192.png\">\n<meta name=\"theme-color\" content=\"#4F46E5\">\n  <style>\n    :root { color-scheme: dark; }\n    * { box-sizing: border-box; }\n    body {\n      margin: 0; min-height: 100vh; display: grid; place-items: center;\n      font-family: 'Inter', system-ui, -apple-system, sans-serif;\n      background: radial-gradient(1200px 600px at 50% -10%, #1e2a5e 0%, #0b1020 60%);\n      color: #e6e9f5; text-align: center; padding: 2rem;\n    }\n    .card {\n      max-width: 460px; padding: 2.5rem 2rem;\n      background: rgba(255, 255, 255, 0.06);\n      backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);\n      border: 1px solid rgba(255, 255, 255, 0.12);\n      border-radius: 24px; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);\n    }\n    /* BRANDING: clean logo, no gradient badge / circle behind it */\n    .icon {\n      width: 96px; height: 96px; margin: 0 auto 1.25rem;\n      display: grid; place-items: center;\n      background: transparent; box-shadow: none;\n    }\n    h1 { font-size: 1.5rem; margin: 0 0 .5rem; }\n    p { color: #aab2d5; line-height: 1.6; margin: 0 0 1.75rem; }\n    button {\n      border: 0; cursor: pointer; padding: .85rem 1.6rem; border-radius: 14px;\n      font-weight: 600; font-size: .98rem; color: #fff;\n      background: linear-gradient(135deg, #6d7bff, #a855f7);\n      box-shadow: 0 8px 24px rgba(109, 123, 255, 0.45);\n      transition: transform .15s ease, box-shadow .15s ease;\n    }\n    button:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(109, 123, 255, 0.6); }\n    .logo { width: 96px; height: 96px; object-fit: contain; }\n  </style>\n  <link rel=\"stylesheet\" href=\"/css/rescue.css\" />\n<link rel=\"stylesheet\" href=\"/css/workspace-redesign.css\" />\n</head>\n<body>\n  <main class=\"card\">\n    <div class=\"icon\"><img class=\"logo\" src=\"/assets/logo.png\" alt=\"AI Notebook\" /></div>\n    <h1>You're offline</h1>\n    <p>AI Notebook can't reach the internet right now. Your saved chats and notes are still available once you reconnect.</p>\n    <button onclick=\"location.reload()\">Try again</button>\n  </main>\n  <script>\n    // Auto-retry when the connection returns.\n    window.addEventListener('online', () => location.reload());\n  </script>\n</body>\n</html>\n"}